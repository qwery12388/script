local function applyChams(obj, isPlayer)
    if obj:FindFirstChild("WalkerChams") then obj.WalkerChams:Destroy() end
    if obj:FindFirstChild("PlayerChams") then obj.PlayerChams:Destroy() end
    local tag = isPlayer and "PlayerChams" or "WalkerChams"
    local highlight = Instance.new("Highlight")
    highlight.Name = tag; highlight.FillTransparency = 0.3; highlight.OutlineTransparency = 0; highlight.Adornee = obj; highlight.Parent = obj
    highlight.FillColor = isPlayer and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(0, 255, 0)
    highlight.OutlineColor = isPlayer and Color3.fromRGB(0, 50, 150) or Color3.fromRGB(0, 100, 0)
end

local function trackCharacter(char)
    if not char or not char.Parent or char == Players.LocalPlayer.Character then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local isPlayer = false
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Clothing") or string.find(string.lower(child.Name), "pant") or string.find(string.lower(child.Name), "shirt") then
            isPlayer = true; break
        end
    end
    local nameLower = string.lower(char.Name)
    local parentNameLower = char.Parent and string.lower(char.Parent.Name) or ""
    if string.find(nameLower, "walker") or string.find(parentNameLower, "walker") or string.find(nameLower, "zombie") or string.find(nameLower, "bot") then
        isPlayer = false
    end
    applyChams(char, isPlayer)
    if not table.find(targetsList, char) then table.insert(targetsList, char) end
end

for _, v in ipairs(workspace:GetDescendants()) do
    if v:IsA("Humanoid") and v.Parent then trackCharacter(v.Parent) end
end

workspace.DescendantAdded:Connect(function(v)
    if v:IsA("Humanoid") then
        task.wait(0.1)
        if v.Parent then trackCharacter(v.Parent) end
    end
end)

local function getClosestTarget()
    local closest = nil; local shortest = math.huge; local mousePos = Vector2.new(Mouse.X, Mouse.Y)
    for i = #targetsList, 1, -1 do
        local obj = targetsList[i]
        if obj and obj.Parent then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local part = obj:FindFirstChild("HeadHitbox") or obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
            if hum and part and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < FOV_RADIUS and dist < shortest then shortest = dist; closest = part end
                end
            end
        else table.remove(targetsList, i) end
    end
    return closest
end

UIS.InputBegan:Connect(function(i, p)
    if p then return end
    if i.UserInputType == AIM_KEY then isAiming = true elseif i.KeyCode == ZOOM_KEY then isZooming = true end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == AIM_KEY then isAiming = false elseif i.KeyCode == ZOOM_KEY then isZooming = false end
end)

RunService.RenderStepped:Connect(function()
    fovFrame.Position = UDim2.new(0, Mouse.X, 0, Mouse.Y + 36)
    Camera.FieldOfView = Camera.FieldOfView + ((isZooming and ZOOM_FOV or DEFAULT_FOV) - Camera.FieldOfView) * 0.2
    Lighting.Ambient = _G.FullBrightEnabled and Color3.fromRGB(255,255,255) or origAmbient
    Lighting.OutdoorAmbient = _G.FullBrightEnabled and Color3.fromRGB(255,255,255) or origOutdoorAmbient
    if isAiming then
        local t = getClosestTarget()
        if t then Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, t.Position), SMOOTHNESS) end
    end
end)

